{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "lint:js": "eslint resources/assets/src/scripts",
    "lint:css": "stylelint resources/assets/src/styles/**/*.scss",
    "lint": "npm run lint:js && npm run lint:css",
    "fix:js": "eslint resources/assets/src/scripts --fix",
    "fix:css": "stylelint resources/assets/src/styles/**/*.scss --fix",
    "fix": "npm run fix:js && npm run fix:css",
    "format": "prettier --write resources/assets/src/**/*.{js,scss}"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.0",
    "git-commit-msg-linter": "^5.0.10",
    "glob": "^13.0.7",
    "lightningcss": "^1.33.0",
    "prettier": "^3.10.0",
    "sass": "^1.108.2",
    "stylelint": "^16.12.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "vite": "^6.4.2",
    "vite-plugin-live-reload": "^3.1.0"
  },
  "dependencies": {
    "sweetalert2": "^11.26.25"
  },
  "overrides": {
    "minimatch@3": {
      "brace-expansion": "1.1.21"
    }
  }
}
